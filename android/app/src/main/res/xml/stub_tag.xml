<?xml version="1.0" encoding="utf-8"?>
<!-- Registers Stub for the NFC Forum Type 4 tag application id, so a tapping phone reads Stub's code. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/nfc_tag_description"
    android:requireDeviceUnlock="true">
    <aid-group android:category="other" android:description="@string/nfc_tag_description">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
